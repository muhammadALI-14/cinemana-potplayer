{
  "manifest_version": 3,
  "name": "Cinemana → PotPlayer",
  "version": "1.5.0",
  "description": "فتح حلقات ومشاهد Cinemana مباشرة في PotPlayer",
  "author": "Muhammad ALI (muhammadALI-14)",
  "permissions": ["webRequest", "storage", "tabs"],
  "host_permissions": [
    "*://*.shabakaty.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://cinemana.shabakaty.com/video/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
