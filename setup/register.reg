Windows Registry Editor Version 5.00

; Run register.bat (auto-elevates to Admin) instead of this file.
; It copies open.vbs to C:\ProgramData\cinemana\open.vbs (absolute fixed path)
; and registers that path - survives folder deletion/rename.

[HKEY_CLASSES_ROOT\cinemana-player]
@="URL:cinemana-player Protocol"
"URL Protocol"=""

[HKEY_CLASSES_ROOT\cinemana-player\shell\open\command]
@="wscript.exe \"C:\\ProgramData\\cinemana\\open.vbs\" \"%1\""
